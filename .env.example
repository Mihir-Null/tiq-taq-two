# Copy to `.env` (or set as environment variables when running `npm run build`).
# Every variable is optional.

# Your Tiq Taq Two lobby server. Enables "server rooms" and the public lobby
# list for a build hosted elsewhere (e.g. GitHub Pages). When the Node server
# hosts the app itself, leave this empty — the app finds it on its own origin.
# VITE_SERVER_URL=https://tiq.example.com

# Hide peer-to-peer rooms (e.g. if you only want server rooms).
# VITE_DISABLE_P2P=1

# Use your own PeerJS signalling server instead of the free public one.
# (Run one with:  npx peerjs --port 9000)
# VITE_PEER_HOST=peer.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=1
# VITE_PEER_KEY=peerjs

# Extra ICE servers for WebRTC — add a TURN server if some players sit behind
# strict NATs / corporate firewalls and can't connect peer-to-peer.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
